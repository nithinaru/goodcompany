# JSON map of bearer token -> bot id. Needs: admin, chief, nithin, maya, daniel, priya.
# Generate locally with: node scripts/gen-env.mjs  (writes .env.local)
BOT_TOKENS='{"tok_admin":"admin","tok_chief":"chief","tok_nithin":"nithin","tok_maya":"maya","tok_daniel":"daniel","tok_priya":"priya"}'

# Eval baseline (section 7)
XAI_API_KEY=
XAI_MODEL=grok-4

# Where eval/score.ts and scripts/smoke.sh find the service
SERVICE_URL=http://localhost:3000

# Optional: persistent storage. Without these, state is in memory (fine locally, NOT on Vercel).
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
